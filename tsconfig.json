{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"useDefineForClassFields": true,
		"noEmit": true
	},
	"include": ["src"]
}
