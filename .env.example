# Скопируйте этот файл в `.env` и заполните свои значения.
#   cp .env.example .env
# Ключи подхватываются автоматически из `.env` при запуске release-скриптов.
# НЕ коммитьте `.env` (он в .gitignore).

# ---- Подписанный Firefox/Mozilla add-on -------------------------------
# Получить ключи: https://addons.mozilla.org/en-US/developers/addon/api/key/
FIREFOX_API_KEY=
FIREFOX_API_SECRET=

# Установите 1, чтобы вообще пропустить подпись (собрать без .xpi)
SKIP_SIGN=0