# Скопируйте этот файл в `.env` и заполните свои значения.
#   cp .env.example .env
# Ключи подхватываются автоматически из `.env` при запуске release-скриптов.
# НЕ коммитьте `.env` (он в .gitignore).

# ---- Подписанный Firefox/Mozilla add-on -------------------------------
# Получить ключи: https://addons.mozilla.org/en-US/developers/addon/api/key/
FIREFOX_API_KEY=
FIREFOX_API_SECRET=

# ID аддона в Firefox (должен совпадать с аддоном, созданным на
# addons.mozilla.org). Если id не существует на AMO, подпись вернёт
# "Conflict". Перепишите под свой аддон.
GECKO_ID=helper-extension-s21@example.com

# Установите 1, чтобы вообще пропустить подпись (собрать без .xpi)
SKIP_SIGN=0

# Таймаут (в секундах) ожидания ответа Mozilla при подписи.
# web-ext sign ждёт "Waiting for validation/approval" — чтобы скрипт не
# зависал навсегда, он прерывается по таймауту и продолжает без .xpi.
FIREFOX_SIGN_TIMEOUT=600