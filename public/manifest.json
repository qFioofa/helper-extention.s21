{
	"manifest_version": 3,
	"name": "Helper Extension S21",
	"version": "1.1.0",
	"description": "Вспомогательное расширение для реализации полезных дополнительных функций на платформе s21.",
	"action": {
		"default_popup": "index.html",
		"default_title": "Helper Extension S21",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"toggle-helper-panel": {
			"suggested_key": {
				"default": "Ctrl+M"
			},
			"description": "Открыть или закрыть панель расширения"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://platform.21-school.ru/*", "https://auth.21-school.ru/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"permissions": ["storage", "tabs", "cookies", "alarms"],
	"host_permissions": ["https://platform.21-school.ru/*", "https://auth.21-school.ru/*"],
	"web_accessible_resources": [
		{
			"resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"],
			"matches": ["https://platform.21-school.ru/*", "https://auth.21-school.ru/*"]
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "addon@example.com",
			"strict_min_version": "109.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
