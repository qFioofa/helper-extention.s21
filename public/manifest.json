{
	"manifest_version": 2,
	"name": "Helper Extension S21",
	"version": "0.0.1",
	"description": "Simple demo extension for s21 built with Svelte, Vite and Tailwind CSS",
	"browser_action": {
		"default_popup": "index.html",
		"default_title": "Helper Extension S21",
		"default_icon": "icons/icon16.png"
	},
	"background": {
		"scripts": ["background.js"],
		"persistent": false
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"permissions": ["storage", "tabs"],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
