{
	"manifest_version": 3,
	"name": "Helper Extension S21",
	"version": "0.0.1",
	"description": "Вспомогательное расширение для реализации полезных дополнительных функций на платформе s21.",
	"action": {
		"default_popup": "index.html",
		"default_title": "Helper Extension S21",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://platform.21-school.ru/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"permissions": ["storage", "tabs"],
	"host_permissions": ["https://platform.21-school.ru/*"],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
